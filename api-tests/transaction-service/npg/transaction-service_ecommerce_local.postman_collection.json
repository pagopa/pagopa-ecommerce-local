    {
      "name": "Get transaction outcomes by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"[pagopa-ecommerce-transaction-service] Get transaction outcomes by id (status code 200) for NPG transaction\", () => {\n  const responseJson = pm.response.json();\n  pm.expect(responseJson.outcome).to.be.a('number');\n  pm.expect(responseJson.outcome).to.be.equal(0);\n  pm.expect(responseJson.isFinalStatus).to.be.a('boolean');\n  pm.expect(responseJson.isFinalStatus).to.be.equal(true);\n  if (responseJson.totalAmount !== undefined) {\n    pm.expect(responseJson.totalAmount).to.be.a('number');\n  }\n  if (responseJson.fees !== undefined) {\n    pm.expect(responseJson.fees).to.be.a('number');\n  }\n  pm.response.to.have.status(200);\n});\n"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const getTransaction = {\n    url: `${pm.environment.get(\"HOSTNAME\")}:${pm.environment.get(\"TRANSACTION_SERVICE_PORT\")}/transactions/${pm.environment.get(\"TRANSACTION_ID\")}/outcomes`,\n    method: 'GET',\n    header: {\n        'Content-Type': 'application/json',\n        'x-api-key': `${pm.environment.get(\"PRIMARY_API_KEY\")}`\n    }\n};\n\nexecuteGetTransactionRequest()\n\nasync function executeGetTransactionRequest (){\n        const maxAttempts = 10;\n        var counter = 0;\n        var transactionOutcome = null;\n        var isFinal = false;\n        const waitForStatus = 0;\n        while (counter < maxAttempts && transactionOutcome != waitForStatus && isFinal == false) {\n            await new Promise(r => setTimeout(r, 1000));\n            await new Promise ((resolve, reject) => pm.sendRequest(getTransaction, (error, response) => {\n                if (error) {\n                    console.log(`Error retrieving transaction by id: ${error.code}`);\n                    reject(error)\n                } else {\n                    const responseBody = response.json();\n                    transactionOutcome = responseBody.outcome;\n                    isFinal = responseBody.isFinalStatus;\n                    console.log(`Transaction outcome: ${transactionOutcome}`)\n                    resolve(transactionOutcome);\n                }\n            }));\n        counter++;\n    }\n    if(waitForStatus !== transactionOutcome){\n        throw new Error(`Wanted transaction in status: ${waitForStatus} but was: ${transactionOutcome}`);\n    }\n\n}\n\n"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "apikey",
          "apikey": [
            {
              "key": "value",
              "value": "{{PRIMARY_API_KEY}}",
              "type": "string"
            },
            {
              "key": "key",
              "value": "x-api-key",
